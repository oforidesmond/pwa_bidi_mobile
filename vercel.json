{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://api.bidimobile.org/auth/:path*"
    },
    {
      "source": "/wallet/:path*",
      "destination": "https://api.bidimobile.org/wallet/:path*"
    },
    {
      "source": "/user/:path*",
      "destination": "https://api.bidimobile.org/user/:path*"
    },
    {
      "source": "/transactions/:path*",
      "destination": "https://api.bidimobile.org/transactions/:path*"
    },
    {
      "source": "/attendants/:path*",
      "destination": "https://api.bidimobile.org/attendants/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
