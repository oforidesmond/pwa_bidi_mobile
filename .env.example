# Leave empty to use same-origin requests.
# Dev: Vite proxies /auth,/wallet,/user,/transactions,/attendants → http://localhost:3000
# Prod (Vercel): vercel.json proxies those paths → https://api.bidimobile.org
VITE_API_URL=
# Only set this if you want the browser to call the API directly (requires CORS):
# VITE_API_URL=https://api.bidimobile.org
VITE_USSD_CODE=*928*198#

